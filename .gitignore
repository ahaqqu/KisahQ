# Dependencies
node_modules/

# Build output
dist/
.astro/

# HyperFrames render output + machine-local state (history, snapshots)
videos/
.hyperframes/
# Local installs use bun (worktree inode sharing); the committed lockfile is npm's package-lock.json (CI runs npm ci)
bun.lock

# Wrangler local state
.wrangler/

# Env and secrets (never commit; never read .env contents)
.env
.env.*
!.env.example
.dev.vars

# OS / editor
.DS_Store
*.log
